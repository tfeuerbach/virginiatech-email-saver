# AWS KMS (for encrypting stored credentials)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
KMS_KEY_ID=arn:aws:kms:us-east-1:123456789:key/your-key-id

# Flask
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate-a-random-hex-string-here

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate-a-random-password
POSTGRES_DB=encrypted_credentials

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Email notifications (optional — leave blank to disable)
# Works with any SMTP provider: AWS SES, Gmail app passwords, SendGrid, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=VT Email Saver
SMTP_USE_TLS=true

# Twilio SMS notifications (optional — leave blank to disable)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# set to false to see the Chrome window (local dev outside Docker only)
#SELENIUM_HEADLESS=false
